// Canonical Prisma Models: bricks/user-profile/schemas/user-profile.prisma
// Supports both normalized `OAuthAccount` records and JSONB `User.profile` backward compatibility.

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String?
  role             String         @default("user")
  firstName        String?
  lastName         String?
  fullName         String?
  avatarUrl        String?
  isSyntheticEmail Boolean        @default(false)
  profile          Json?          @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  oauthAccounts    OAuthAccount[]
  sessions         Session[]
}

model OAuthAccount {
  id                String    @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  displayName       String?
  avatarUrl         String?
  accessToken       String?
  refreshToken      String?
  tokenExpiresAt    DateTime?
  scopes            String[]
  rawProfile        Json?     @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  platform  String   @default("web")
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
