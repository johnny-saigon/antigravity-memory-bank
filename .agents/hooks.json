{
  "antigravity-memory-bank": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/sync-memory-context.mjs --quiet --hook SessionStart 2>/dev/null || node ../scripts/sync-memory-context.mjs --quiet --hook SessionStart 2>/dev/null || echo '{}'",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/sync-memory-context.mjs --quiet --hook PostToolUse 2>/dev/null || node ../scripts/sync-memory-context.mjs --quiet --hook PostToolUse 2>/dev/null || echo '{}'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/sync-memory-context.mjs --quiet --hook Stop 2>/dev/null || node ../scripts/sync-memory-context.mjs --quiet --hook Stop 2>/dev/null || echo '{\"decision\":\"allow\"}'",
        "timeout": 5
      }
    ]
  }
}
