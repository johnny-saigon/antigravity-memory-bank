{
  "name": "antigravity-memory-bank",
  "version": "1.4.0",
  "description": "Three-Tier Memory Bank brick and Antigravity plugin for autonomous agentic pair programming",
  "type": "module",
  "main": "./bin/cli.mjs",
  "bin": {
    "antigravity-memory": "./bin/cli.mjs",
    "agy-memory": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "rules/",
    "scripts/",
    "skills/",
    "templates/",
    "plugin.json",
    "install.sh"
  ],
  "scripts": {
    "lint:memory": "node scripts/lint-memory.mjs",
    "test": "node scripts/lint-memory.mjs && echo \"All memory templates pass line budget!\"",
    "memory:sync": "node scripts/sync-memory-context.mjs",
    "memory:upgrade": "npx github:johnny-saigon/antigravity-memory-bank upgrade",
    "memory:export": "npx github:johnny-saigon/antigravity-memory-bank export",
    "memory:uninstall": "npx github:johnny-saigon/antigravity-memory-bank uninstall",
    "backlog": "node scripts/backlog.mjs",
    "backlog:list": "node scripts/backlog.mjs list",
    "backlog:add": "node scripts/backlog.mjs add",
    "backlog:start": "node scripts/backlog.mjs start",
    "backlog:done": "node scripts/backlog.mjs done",
    "backlog:render": "node scripts/backlog.mjs render",
    "backlog:serve": "node scripts/backlog.mjs serve"
  },
  "keywords": [
    "antigravity",
    "memory-bank",
    "agentic-coding",
    "plugin",
    "context-management",
    "three-tier-memory",
    "gemini"
  ],
  "author": "johnny-saigon <https://github.com/johnny-saigon>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnny-saigon/antigravity-memory-bank.git"
  },
  "bugs": {
    "url": "https://github.com/johnny-saigon/antigravity-memory-bank/issues"
  },
  "homepage": "https://github.com/johnny-saigon/antigravity-memory-bank#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
